generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model usuarios {
  id                       BigInt                     @id @default(autoincrement())
  nome                     String                     @db.VarChar(150)
  email                    String                     @unique(map: "uq_usuarios_email") @db.VarChar(254)
  password_hash            String
  tipo                     String                     @db.VarChar(20)
  ativo                    Boolean                    @default(true)
  deve_alterar_senha       Boolean                    @default(false)
  criado_em                DateTime                   @default(now()) @db.Timestamptz(6)
  actualizado_em           DateTime                   @updatedAt @db.Timestamptz(6)
  medico                   medicos?
  notificacoes             notificacoes[]
  paciente                 pacientes?
  auditorias               registos_auditoria[]
  tokens_redefinicao_senha tokens_redefinicao_senha[]

  @@index([tipo, ativo], map: "idx_usuarios_tipo_ativo")
  @@map("usuarios")
}

model pacientes {
  id               BigInt      @id @default(autoincrement())
  usuario_id       BigInt      @unique(map: "uq_pacientes_usuario")
  telefone         String?     @db.VarChar(30)
  data_nascimento  DateTime?   @db.Date
  sexo             String?     @db.VarChar(20)
  endereco         String?     @db.VarChar(255)
  numero_documento String?     @db.VarChar(80)
  criado_em        DateTime    @default(now()) @db.Timestamptz(6)
  actualizado_em   DateTime    @updatedAt @db.Timestamptz(6)
  consultas        consultas[]
  usuario          usuarios    @relation(fields: [usuario_id], references: [id])

  @@map("pacientes")
}

model especialidades {
  id             BigInt    @id @default(autoincrement())
  nome           String    @unique(map: "uq_especialidades_nome") @db.VarChar(120)
  descricao      String?
  ativo          Boolean   @default(true)
  criado_em      DateTime  @default(now()) @db.Timestamptz(6)
  actualizado_em DateTime  @updatedAt @db.Timestamptz(6)
  medicos        medicos[]

  @@index([ativo, nome], map: "idx_especialidades_ativo_nome")
  @@map("especialidades")
}

model medicos {
  id               BigInt             @id @default(autoincrement())
  usuario_id       BigInt             @unique(map: "uq_medicos_usuario")
  especialidade_id BigInt
  sexo             String?            @db.VarChar(20)
  biografia        String?
  experiencia      String?            @db.VarChar(100)
  telefone         String?            @db.VarChar(30)
  numero_ordem     String?            @db.VarChar(100)
  fotografia_url   String?
  valor_consulta   Decimal?           @db.Decimal(12, 2)
  duracao_consulta Int                @default(30)
  perfil_aprovado  Boolean            @default(false)
  criado_em        DateTime           @default(now()) @db.Timestamptz(6)
  actualizado_em   DateTime           @updatedAt @db.Timestamptz(6)
  consultas        consultas[]
  disponibilidades disponibilidades[]
  especialidade    especialidades     @relation(fields: [especialidade_id], references: [id])
  usuario          usuarios           @relation(fields: [usuario_id], references: [id])

  @@index([especialidade_id], map: "idx_medicos_especialidade")
  @@index([perfil_aprovado], map: "idx_medicos_perfil_aprovado")
  @@map("medicos")
}

model disponibilidades {
  id             BigInt      @id @default(autoincrement())
  medico_id      BigInt
  data           DateTime    @db.Date
  hora_inicio    DateTime    @db.Time(6)
  hora_fim       DateTime    @db.Time(6)
  estado         String      @default("disponivel") @db.VarChar(20)
  observacoes    String?
  criado_em      DateTime    @default(now()) @db.Timestamptz(6)
  actualizado_em DateTime    @updatedAt @db.Timestamptz(6)
  consultas      consultas[]
  medico         medicos     @relation(fields: [medico_id], references: [id])

  @@index([medico_id, data], map: "idx_disponibilidades_medico_data")
  @@index([data, estado], map: "idx_disponibilidades_data_estado")
  @@map("disponibilidades")
}

model consultas {
  id                  BigInt             @id @default(autoincrement())
  paciente_id         BigInt
  medico_id           BigInt
  disponibilidade_id  BigInt
  estado              String             @default("pendente") @db.VarChar(20)
  motivo              String?
  observacoes         String?
  motivo_cancelamento String?
  cancelada_em        DateTime?          @db.Timestamptz(6)
  confirmada_em       DateTime?          @db.Timestamptz(6)
  concluida_em        DateTime?          @db.Timestamptz(6)
  criado_em           DateTime           @default(now()) @db.Timestamptz(6)
  actualizado_em      DateTime           @updatedAt @db.Timestamptz(6)
  disponibilidade     disponibilidades   @relation(fields: [disponibilidade_id], references: [id])
  medico              medicos            @relation(fields: [medico_id], references: [id])
  paciente            pacientes          @relation(fields: [paciente_id], references: [id])
  registo_clinico     registos_clinicos?

  @@index([paciente_id, criado_em(sort: Desc)], map: "idx_consultas_paciente_data")
  @@index([medico_id, estado], map: "idx_consultas_medico_estado")
  @@index([disponibilidade_id, estado], map: "idx_consultas_disponibilidade_estado")
  @@index([estado, criado_em], map: "idx_consultas_estado_data")
  @@map("consultas")
}

model registos_clinicos {
  id               BigInt    @id @default(autoincrement())
  consulta_id      BigInt    @unique(map: "uq_registos_clinicos_consulta")
  queixa_principal String?
  observacoes      String?
  diagnostico      String?
  tratamento       String?
  prescricao       String?
  notas            String?
  recomendacoes  String?
  criado_em        DateTime  @default(now()) @db.Timestamptz(6)
  actualizado_em   DateTime  @updatedAt @db.Timestamptz(6)
  consulta         consultas @relation(fields: [consulta_id], references: [id])

  @@map("registos_clinicos")
}

model tokens_redefinicao_senha {
  id           BigInt    @id @default(autoincrement())
  usuario_id   BigInt
  token_hash   String    @unique(map: "uq_tokens_redefinicao_hash") @db.VarChar(255)
  expira_em    DateTime  @db.Timestamptz(6)
  utilizado_em DateTime? @db.Timestamptz(6)
  criado_em    DateTime  @default(now()) @db.Timestamptz(6)
  usuario      usuarios  @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@index([usuario_id, expira_em], map: "idx_tokens_redefinicao_usuario_expira")
  @@map("tokens_redefinicao_senha")
}

model notificacoes {
  id          BigInt    @id @default(autoincrement())
  usuario_id  BigInt
  titulo      String    @db.VarChar(180)
  mensagem    String
  tipo        String    @default("geral") @db.VarChar(40)
  lida        Boolean   @default(false)
  lida_em     DateTime? @db.Timestamptz(6)
  consulta_id BigInt?
  criado_em   DateTime  @default(now()) @db.Timestamptz(6)
  usuario     usuarios  @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@index([usuario_id, lida, criado_em(sort: Desc)], map: "idx_notificacoes_usuario_lida")
  @@index([consulta_id], map: "idx_notificacoes_consulta")
  @@map("notificacoes")
}

model registos_auditoria {
  id          BigInt    @id @default(autoincrement())
  usuario_id  BigInt?
  accao       String    @db.VarChar(120)
  entidade    String?   @db.VarChar(100)
  entidade_id String?   @db.VarChar(100)
  descricao   String?
  endereco_ip String?   @db.VarChar(45)
  user_agent  String?
  detalhes    Json?
  criado_em   DateTime  @default(now()) @db.Timestamptz(6)
  usuario     usuarios? @relation(fields: [usuario_id], references: [id])

  @@index([usuario_id, criado_em(sort: Desc)], map: "idx_auditoria_usuario_data")
  @@index([accao, criado_em(sort: Desc)], map: "idx_auditoria_accao_data")
  @@index([entidade, entidade_id], map: "idx_auditoria_entidade")
  @@map("registos_auditoria")
}

model configuracoes_sistema {
  id             BigInt   @id @default(autoincrement())
  chave          String   @unique(map: "uq_configuracoes_chave") @db.VarChar(120)
  valor          Json
  descricao      String?
  actualizado_em DateTime @updatedAt @db.Timestamptz(6)

  @@map("configuracoes_sistema")
}
